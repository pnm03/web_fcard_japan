{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nihongo Flashcard",
  "version": "0.1.0",
  "identifier": "app.nihongo.flashcard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nihongo Flashcard",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "pnm03",
    "shortDescription": "Ứng dụng học và ôn từ vựng tiếng Nhật thông minh",
    "longDescription": "Nihongo Flashcard cho Windows với lịch ôn, thông báo native, system tray và đồng bộ Supabase.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
