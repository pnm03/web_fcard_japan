{
  "name": "web-flashcard-nh-t",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "widget": "electron .",
    "widget:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "electron:pack": "npm run build && electron-builder --win --dir",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "build": {
    "appId": "com.nihongo.flashcard",
    "productName": "Nihongo Flashcard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src-tauri/icons/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src-tauri/icons/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nihongo Flashcard",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^8.0.12",
    "wait-on": "^9.4.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "ts-fsrs": "^5.4.1"
  }
}